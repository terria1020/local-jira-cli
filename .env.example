# Path to Atlassian ACLI binary (optional)
# ACLI_PATH=acli

# Optional default project key used when --project is omitted
# JIRA_DEFAULT_PROJECT=TEAM

# Optional Jira REST settings used by transition-list
# JIRA_SITE=your-workspace.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN_FILE=~/.atlassian_token
# JIRA_API_TOKEN=your-api-token

# Log level: debug | info | warn | error
LOG_LEVEL=info
